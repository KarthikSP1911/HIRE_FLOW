{
  "name": "hireflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:py": "ruff check . && ruff format --check .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "commit": "cz",
    "prepare": "husky",
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "typecheck": "npm run typecheck -w web"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/cz-commitlint": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.6",
    "commitizen": "^4.3.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "inquirer": "^9.3.8",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-java": "^2.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
