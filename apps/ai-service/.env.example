APP_NAME=ai-service
ENVIRONMENT=local
LOG_LEVEL=INFO

# Speech to text
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_BEAM_SIZE=1
MAX_AUDIO_MB=25

# Decision model: strands | laya
LABELLER=strands
DECIDER_URL=http://localhost:8100
LAYA_URL=http://localhost:8888
LAYA_MODEL=laya-multilingual
# LAYA_API_KEY=
CONTEXT_SENTENCES=4

# Verifier thresholds
CONFIDENCE_THRESHOLD=0.6
STT_LOW_CONFIDENCE=0.7
