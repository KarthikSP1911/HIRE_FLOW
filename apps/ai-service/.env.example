APP_NAME=ai-service
ENVIRONMENT=local
LOG_LEVEL=INFO

# Speech to text
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_BEAM_SIZE=1
MAX_AUDIO_MB=25

# Decision model: strands | laya
LABELLER=strands
DECIDER_URL=http://localhost:8100
LAYA_URL=http://localhost:8888
LAYA_MODEL=laya-multilingual
# LAYA_API_KEY=
CONTEXT_SENTENCES=4

# Verifier thresholds
CONFIDENCE_THRESHOLD=0.6
STT_LOW_CONFIDENCE=0.7

# Topics, question bank and answer rating (defaults are the files in src/ai_service/config)
# TOPICS_PATH=
# QUESTION_BANK_PATH=
TOPIC_CONFIDENCE_THRESHOLD=0.6
BANK_MATCH_THRESHOLD=0.5
OLLAMA_URL=http://localhost:11434
# qwen3.5:9b rates better but needs about 6.6 GB and a GPU or a lot of patience on CPU
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=180
# dual: two differently framed prompts, flagged when they diverge | single: one prompt
# Start Ollama with OLLAMA_NUM_PARALLEL=2 so dual mode takes about as long as single.
RATING_PROMPT_MODE=dual
